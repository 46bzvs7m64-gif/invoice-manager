# ===== 发票管家 环境配置（复制为 .env 后按需修改） =====

# 数据库路径（默认 backend/data/invoices.db，可留空使用默认）
# DATABASE_URL=sqlite:///./data/invoices.db

# 发票文件存储目录（默认 backend/invoices_files）
# STORAGE_PATH=./invoices_files

# 百炼 API Key（必填：https://bailian.console.aliyun.com 获取）
QWEN_API_KEY=
# OpenAI 兼容接口地址（默认华北2北京；新加坡改为 https://dashscope-intl.aliyuncs.com/compatible-mode/v1）
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 识别模型：qwen3.8-flash（低成本，默认）/ qwen3.8-max（高精度）
QWEN_MODEL=qwen3.8-flash

# 授权码加密密钥（首次启动自动生成并追加到本文件，无需手动填写）
# ENCRYPTION_KEY=

# 默认采集最近天数
DEFAULT_SYNC_DAYS=90

# 服务监听地址与端口（0.0.0.0 允许手机通过局域网访问）
HOST=0.0.0.0
PORT=8000
